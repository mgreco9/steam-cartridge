<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CartridgeDesigner.Avalonia.ViewModels.LibraryViewModel"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:CartridgeDesigner.Avalonia.Views.LibraryView"
             mc:Ignorable="d"
             x:DataType="vm:LibraryFolderViewModel"
             x:Class="CartridgeDesigner.Avalonia.Views.LibraryView.LibraryFolderView">

    <Grid RowDefinitions="Auto,Auto,*" Margin="4">

        <!-- ======================================================== -->
        <!-- SEARCH BAR                                              -->
        <!-- ======================================================== -->
        <TextBox Grid.Row="0"
                 PlaceholderText="Search games..."
                 Text="{Binding SearchText}"
                 Margin="0,0,0,8"
                 Padding="8,6"/>

        <!-- ======================================================== -->
        <!-- FILTER OPTIONS                                          -->
        <!-- ======================================================== -->
        <Border Grid.Row="1"
                Background="#202020"
                BorderBrush="#383838"
                BorderThickness="1"
                CornerRadius="6"
                Padding="8"
                Margin="0,0,0,8">

            <Grid ColumnDefinitions="*,*">
                <!-- Design Status Filters -->
                <StackPanel Grid.Column="0" Margin="4,0,8,0">
                    <TextBlock Text="Design"
                               FontWeight="Bold"
                               FontSize="12"
                               Foreground="#BBB"
                               Margin="0,0,0,4"/>

                    <ItemsControl ItemsSource="{Binding DesignFilter}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Value}"
                                          IsChecked="{Binding IsEnabled}"
                                          Margin="0,2"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Physical Cartridge Filters -->
                <StackPanel Grid.Column="1" Margin="8,0,4,0">
                    <TextBlock Text="Cartridge"
                               FontWeight="Bold"
                               FontSize="12"
                               Foreground="#BBB"
                               Margin="0,0,0,4"/>

                    <ItemsControl ItemsSource="{Binding CartridgeFilter}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Value}"
                                          IsChecked="{Binding IsEnabled}"
                                          Margin="0,2"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ======================================================== -->
        <!-- GAME LIST                                               -->
        <!-- ======================================================== -->
        <ListBox Grid.Row="2"
                 ItemsSource="{Binding FilteredGameList}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 Background="Transparent"
                 BorderThickness="0">

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border PointerPressed="OnItemPressed"
                            Background="{Binding IsSelected, Converter={StaticResource HighlightConverter}}"
                            CornerRadius="5"
                            Padding="8,6"
                            Margin="0,1">

                        <Grid ColumnDefinitions="*,Auto">
                            <!-- Game Name -->
                            <TextBlock Grid.Column="0"
                                       Text="{Binding Game.Name}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0"/>

                            <!-- Ignore / Unignore Button -->
                            <Button Grid.Column="1"
                                    Command="{Binding $parent[ListBox].((vm:LibraryFolderViewModel)DataContext).IgnoreGame}"
                                    CommandParameter="{Binding}"
                                    Content="{Binding IgnoreButton}"
                                    ToolTip.Tip="Toggle ignore status"
                                    Padding="6,2"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>

    <UserControl.Resources>
        <local:HighlightConverter x:Key="HighlightConverter"/>
    </UserControl.Resources>
</UserControl>
