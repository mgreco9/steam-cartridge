<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CartridgeDesigner.Avalonia.ViewModels.LibraryViewModel"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:DataType="vm:LibraryCartridgeViewModel"
             x:Class="CartridgeDesigner.Avalonia.Views.LibraryView.LibraryCartridgeView">

    <Grid x:Name="Viewport"
          Background="#141414"
          RowDefinitions="Auto,*,Auto"
          Margin="6">

        <!-- ======================================================== -->
        <!-- SELECTED GAME TITLE                                      -->
        <!-- ======================================================== -->
        <TextBlock Grid.Row="0"
                   Text="{Binding Title}"
                   FontSize="18"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   Margin="10,12"/>

        <!-- ======================================================== -->
        <!-- CARTRIDGE COVER PREVIEW                                  -->
        <!-- ======================================================== -->
        <Border Grid.Row="1"
                Background="#0A0A0A"
                BorderBrush="#2A2A2A"
                BorderThickness="1"
                CornerRadius="6"
                Margin="10,0"
                Padding="8">
            <Image Source="{Binding CoverImage}"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
        </Border>

        <!-- ======================================================== -->
        <!-- ACTION BUTTONS                                           -->
        <!-- ======================================================== -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Spacing="16"
                    Margin="10,14">

            <Button Content="Assign Cartridge"
                    Click="AssignCartridge_Click"
                    IsEnabled="{Binding AssignEnabled}"
                    Padding="14,8"/>

            <Button Content="Edit Cover"
                    Click="EditCover_Click"
                    IsEnabled="{Binding EditEnabled}"
                    Padding="14,8"/>
        </StackPanel>

    </Grid>
</UserControl>
