<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CartridgeDesigner.Avalonia.ViewModels.LibraryViewModel"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:CartridgeDesigner.Avalonia.Views.LibraryView"
             mc:Ignorable="d"
             x:DataType="vm:LibraryMainViewModel"
             x:Class="CartridgeDesigner.Avalonia.Views.LibraryView.LibraryMainView">

    <Grid x:Name="DesignView" Margin="6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="7*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ======================================================== -->
        <!-- LEFT PANEL: FOLDER LIST & FILTERS                       -->
        <!-- ======================================================== -->
        <local:LibraryFolderView Grid.Column="0"
                                 Grid.Row="0"
                                 Grid.RowSpan="2"
                                 x:Name="Folder"
                                 DataContext="{Binding FolderModel}"
                                 Margin="0,0,6,0"/>

        <!-- ======================================================== -->
        <!-- TOP TOOLBAR: ACTIONS                                    -->
        <!-- ======================================================== -->
        <StackPanel Grid.Column="1"
                    Grid.Row="0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="0,0,6,8">

            <Button Content="Sync Library"
                    Click="SyncLibrary_Click"
                    IsEnabled="{Binding LibraryLoaded}"
                    Padding="12,6"/>

            <Button Content="Export Cover"
                    Click="ExportCover_Click"
                    IsEnabled="{Binding ExportEnabled}"
                    Padding="12,6"/>
        </StackPanel>

        <!-- ======================================================== -->
        <!-- RIGHT PANEL: CARTRIDGE DETAIL & PREVIEW                  -->
        <!-- ======================================================== -->
        <local:LibraryCartridgeView Grid.Column="1"
                                     Grid.Row="1"
                                     x:Name="Editor"
                                     DataContext="{Binding CartridgeModel}"/>
    </Grid>
</UserControl>
