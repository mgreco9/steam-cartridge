<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CartridgeDesigner.Avalonia.ViewModels.CartridgeViewModel"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="vm:CartridgeMainViewModel"
             x:Class="CartridgeDesigner.Avalonia.Views.CartridgeView.CartridgeMainView">

    <Grid RowDefinitions="Auto,*,Auto" Margin="16" Background="#141414">

        <!-- ======================================================== -->
        <!-- INSERTED GAME TITLE                                      -->
        <!-- ======================================================== -->
        <TextBlock Grid.Row="0"
                   Text="{Binding GameTitle}"
                   FontSize="22"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Margin="0,10,0,16"/>

        <!-- ======================================================== -->
        <!-- CARTRIDGE COVER PICTURE                                  -->
        <!-- ======================================================== -->
        <Border Grid.Row="1"
                Background="#0A0A0A"
                BorderBrush="#2A2A2A"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Margin="20,0">
            <Image Source="{Binding CoverImage}"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
        </Border>

        <!-- ======================================================== -->
        <!-- LAUNCH BUTTON                                            -->
        <!-- ======================================================== -->
        <Button Grid.Row="2"
                Content="Launch Game"
                Click="LaunchGame_Click"
                IsEnabled="{Binding LaunchEnabled}"
                FontSize="15"
                FontWeight="SemiBold"
                Padding="24,10"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="0,16,0,10"/>
    </Grid>
</UserControl>
