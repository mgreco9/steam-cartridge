<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CartridgeDesigner.Avalonia.ViewModels.DesignViewModel"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:CartridgeDesigner.Avalonia.Views.DesignView"
             x:DataType="vm:DesignTextPanelViewModel"
             x:Class="CartridgeDesigner.Avalonia.Views.DesignView.DesignTextPanelView">

    <StackPanel Spacing="10" Margin="20">

        <!-- Text input -->
        <TextBox Text="{Binding Text}"
                 PlaceholderText="Enter text..."
                 FontSize="16" />

        <!-- Font selector -->
        <ComboBox ItemsSource="{Binding Fonts}"
                  SelectedItem="{Binding SelectedFont}"
                  Width="250" />

        <!-- Color picker (Avalonia 11+) -->
        <StackPanel Spacing="10">

            <TextBlock Text="Choose text color:" />

            <StackPanel Orientation="Horizontal" Spacing="10">

                <!-- Black -->
                <Button Width="40"
                        Height="40"
                        Background="Black"
                        Click="Black_Click" />

                <!-- White -->
                <Button Width="40"
                        Height="40"
                        Background="White"
                        BorderBrush="Black"
                        BorderThickness="1"
                        Click="White_Click" />

            </StackPanel>

        </StackPanel>

        <!-- Preview -->
        <Border x:Name="PreviousBorder" BorderBrush="Gray" BorderThickness="1" Padding="10">
            <TextBlock Text="{Binding Text}"
                       FontFamily="{Binding SelectedFont}"
                       Foreground="{Binding TextColor}"
                       FontSize="32"
                       FontWeight="Bold"
                       TextWrapping="NoWrap" />
        </Border>
    </StackPanel>
</UserControl>