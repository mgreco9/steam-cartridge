<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CartridgeDesigner.Avalonia.ViewModels.DesignViewModel"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CartridgeDesigner.Avalonia.Views.DesignView"
        mc:Ignorable="d"
        x:DataType="vm:DesignMainViewModel"
        x:Class="CartridgeDesigner.Avalonia.Views.DesignView.DesignMainView"
        Title="Cartridge Cover Designer"
        Width="950"
        Height="650"
        WindowStartupLocation="CenterScreen">

    <Grid RowDefinitions="*,Auto" Margin="8">

        <!-- ======================================================== -->
        <!-- DESIGN TABS (IMAGE / BLUR / TEXT)                        -->
        <!-- ======================================================== -->
        <TabControl Grid.Row="0" ItemsSource="{Binding Tabs}">
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Title, Mode=TwoWay}" FontSize="13" />
                </DataTemplate>
            </TabControl.ItemTemplate>
        </TabControl>

        <!-- ======================================================== -->
        <!-- BOTTOM ACTION BUTTONS                                    -->
        <!-- ======================================================== -->
        <Border Grid.Row="1"
                BorderBrush="#333"
                BorderThickness="0,1,0,0"
                Padding="0,10,0,4">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="12">

                <Button Content="Cancel"
                        Click="Cancel_Click"
                        Padding="16,6"/>

                <Button Content="Validate"
                        Click="Validate_Click"
                        Padding="16,6"/>
            </StackPanel>
        </Border>
    </Grid>

    <Window.DataTemplates>
        <DataTemplate DataType="vm:DesignImagePanelViewModel">
            <local:DesignImagePanelView/>
        </DataTemplate>
        <DataTemplate DataType="vm:DesignBlurredPanelViewModel">
            <local:DesignBlurredPanelView/>
        </DataTemplate>
        <DataTemplate DataType="vm:DesignTextPanelViewModel">
            <local:DesignTextPanelView/>
        </DataTemplate>
    </Window.DataTemplates>

</Window>
