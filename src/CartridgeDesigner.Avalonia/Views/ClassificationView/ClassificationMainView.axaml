<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:CartridgeDesigner.Avalonia.ViewModels.ClassificationViewModel"
             mc:Ignorable="d"
             x:DataType="vm:ClassificationMainViewModel"
             x:Class="CartridgeDesigner.Avalonia.Views.ClassificationView.ClassificationMainView">

    <Grid ColumnDefinitions="2*,3*,2*" Margin="10">

        <!-- ======================================================== -->
        <!-- LEFT PANEL: UNASSIGNED GAMES                            -->
        <!-- ======================================================== -->
        <Border Grid.Column="0"
                BorderBrush="#444"
                BorderThickness="1"
                CornerRadius="6"
                Padding="8"
                Margin="4"
                Background="#181818">

            <DockPanel>
                <!-- Section Header -->
                <TextBlock DockPanel.Dock="Top"
                           Text="Unassigned Games"
                           FontWeight="Bold"
                           FontSize="14"
                           Margin="4,2,4,8"
                           Foreground="#DDD"/>

                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding GameList}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8"
                                        Margin="0,0,0,6"
                                        Background="#2A2A2A"
                                        CornerRadius="5"
                                        Cursor="Hand"
                                        PointerPressed="Game_PointerPressed">

                                    <Grid ColumnDefinitions="*,Auto">
                                        <!-- Game Name -->
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Game.Name}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,6,0"/>

                                        <!-- Ignore Game Button -->
                                        <Button Grid.Column="1"
                                                Command="{Binding $parent[UserControl].((vm:ClassificationMainViewModel)DataContext).IgnoreGame}"
                                                CommandParameter="{Binding}"
                                                Content="✖"
                                                ToolTip.Tip="Ignore this game"
                                                Padding="6,2"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ======================================================== -->
        <!-- MIDDLE PANEL: SELECTED CATEGORY / FRANCHISES            -->
        <!-- ======================================================== -->
        <Border Grid.Column="1"
                BorderBrush="#444"
                BorderThickness="1"
                CornerRadius="6"
                Padding="8"
                Margin="4"
                Background="#181818"
                DragDrop.AllowDrop="True"
                DragDrop.Drop="MiddlePanel_Drop">

            <DockPanel>
                <!-- Section Header: Category Name or Placeholder -->
                <Grid DockPanel.Dock="Top" Margin="4,2,4,8">
                    <TextBlock Text="{Binding SelectedCategory.Category.Name, FallbackValue='Select a category...'}"
                               FontWeight="Bold"
                               FontSize="14"
                               Foreground="#DDD"
                               TextTrimming="CharacterEllipsis"/>
                </Grid>

                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding SelectedCategory.FranchiseList}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8"
                                        Margin="0,0,0,8"
                                        Background="#2E2E2E"
                                        CornerRadius="6">

                                    <Grid RowDefinitions="Auto,Auto">
                                        <!-- Franchise Name Header -->
                                        <TextBlock Grid.Row="0"
                                                   Text="{Binding Franchise.Name}"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   Foreground="#BBB"
                                                   Margin="2,0,0,6"/>

                                        <!-- Franchise Games -->
                                        <ItemsControl Grid.Row="1" ItemsSource="{Binding GameList}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="6,6,6,6"
                                                            Margin="0,0,0,4"
                                                            Background="#1E1E1E"
                                                            CornerRadius="4">

                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <!-- Game Name -->
                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding Game.Name}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       VerticalAlignment="Center"
                                                                       Margin="0,0,6,0"/>

                                                            <!-- Remove Game from Category Button -->
                                                            <Button Grid.Column="1"
                                                                    Command="{Binding $parent[UserControl].((vm:ClassificationMainViewModel)DataContext).RemoveGameFromCategory}"
                                                                    CommandParameter="{Binding}"
                                                                    Content="✖"
                                                                    ToolTip.Tip="Remove game from category"
                                                                    Padding="6,2"
                                                                    VerticalAlignment="Center"
                                                                    HorizontalAlignment="Right"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ======================================================== -->
        <!-- RIGHT PANEL: CATEGORIES                                 -->
        <!-- ======================================================== -->
        <Border Grid.Column="2"
                BorderBrush="#444"
                BorderThickness="1"
                CornerRadius="6"
                Padding="8"
                Margin="4"
                Background="#181818">

            <DockPanel>
                <!-- Section Header -->
                <TextBlock DockPanel.Dock="Top"
                           Text="Categories"
                           FontWeight="Bold"
                           FontSize="14"
                           Margin="4,2,4,8"
                           Foreground="#DDD"/>

                <!-- Add Category Button -->
                <Button DockPanel.Dock="Bottom"
                        Content="+ New Category"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Margin="0,8,0,0"
                        Click="CreateCategory_Click"/>

                <!-- Category List -->
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding CategoryList}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8"
                                        Margin="0,0,0,6"
                                        Background="#252525"
                                        CornerRadius="5"
                                        Cursor="Hand"
                                        PointerPressed="OnCategoryPressed"
                                        DragDrop.AllowDrop="True"
                                        DragDrop.Drop="Category_Drop">

                                    <Grid ColumnDefinitions="*,Auto">
                                        <!-- Category Name -->
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Category.Name}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,6,0"/>

                                        <!-- Delete Category Button -->
                                        <Button Grid.Column="1"
                                                Command="{Binding $parent[UserControl].((vm:ClassificationMainViewModel)DataContext).RemoveCategory}"
                                                CommandParameter="{Binding}"
                                                Content="✖"
                                                ToolTip.Tip="Delete category"
                                                Padding="6,2"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

    </Grid>

</UserControl>
