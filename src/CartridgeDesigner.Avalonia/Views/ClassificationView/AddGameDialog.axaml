<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:CartridgeDesigner.Avalonia.ViewModels.ClassificationViewModel"
    xmlns:local="clr-namespace:CartridgeDesigner.Avalonia.Views"
    x:Class="CartridgeDesigner.Avalonia.Views.ClassificationView.AddGameDialog"
    x:DataType="vm:AddGameDialogModel"
    Width="400"
    Height="250">

    <StackPanel Margin="20" Spacing="10">

        <TextBlock Text="Configure Item"/>

        <TextBox PlaceholderText="Franchise"
                 Text="{Binding Franchise}" />

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="10">

            <Button Content="Cancel" Command="{Binding CancelCommand}" />
            <Button Content="OK" Command="{Binding ConfirmCommand}" />
        </StackPanel>

    </StackPanel>
</Window>