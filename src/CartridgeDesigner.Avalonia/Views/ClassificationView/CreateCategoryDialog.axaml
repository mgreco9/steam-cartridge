<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:CartridgeDesigner.Avalonia.ViewModels.ClassificationViewModel"
        mc:Ignorable="d"
        x:Class="CartridgeDesigner.Avalonia.Views.ClassificationView.CreateCategoryDialog"
        x:DataType="vm:CreateCategoryDialogModel"
        Title="Create New Category"
        Width="380"
        Height="230"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="20" Spacing="10">
        <TextBlock Text="New Category"
                   FontSize="16"
                   FontWeight="Bold"/>

        <StackPanel Spacing="4">
            <TextBlock Text="Category Name" FontSize="12" Foreground="#BBB"/>
            <TextBox Text="{Binding Name}"
                     PlaceholderText="e.g. Action, RPG, Retro..."/>
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Text="Prefix" FontSize="12" Foreground="#BBB"/>
            <TextBox Text="{Binding Prefix}"
                     PlaceholderText="e.g. ACT, RPG..."/>
        </StackPanel>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="10"
                    Margin="0,10,0,0">
            <Button Content="Cancel"
                    Command="{Binding CancelCommand}"
                    Padding="14,6"/>
            <Button Content="OK"
                    Command="{Binding ConfirmCommand}"
                    Padding="14,6"/>
        </StackPanel>
    </StackPanel>
</Window>
