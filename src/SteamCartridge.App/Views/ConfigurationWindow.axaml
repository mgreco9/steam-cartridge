<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SteamCartridge.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="SteamCartridge.App.Views.ConfigurationWindow"
        x:DataType="vm:ConfigurationWindowModel"
        Width="460"
        Height="460"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/avalonia-logo.ico"
        Title="SteamCartridge — Setup">

    <StackPanel Margin="24" Spacing="12">

        <!-- ======================================================== -->
        <!-- HEADER                                                  -->
        <!-- ======================================================== -->
        <TextBlock Text="SteamCartridge Setup"
                   FontSize="20"
                   FontWeight="Bold"/>

        <TextBlock Text="Please configure your Steam credentials and save directory."
                   Foreground="#AAA"
                   TextWrapping="Wrap"
                   FontSize="13"
                   Margin="0,0,0,8"/>

        <!-- ======================================================== -->
        <!-- FORM FIELDS                                             -->
        <!-- ======================================================== -->
        <StackPanel Spacing="4">
            <TextBlock Text="Steam Client ID" FontWeight="SemiBold" FontSize="12"/>
            <TextBox Text="{Binding SteamClientID}" PlaceholderText="Enter Steam Client ID..."/>
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Text="Steam API Key" FontWeight="SemiBold" FontSize="12"/>
            <TextBox Text="{Binding SteamAPIKey}" PasswordChar="●" PlaceholderText="Enter Steam Web API Key..."/>
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Text="SteamGridDB API Key" FontWeight="SemiBold" FontSize="12"/>
            <TextBox Text="{Binding SteamGridDBAPIKey}" PasswordChar="●" PlaceholderText="Enter SteamGridDB API Key..."/>
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Text="Save Directory" FontWeight="SemiBold" FontSize="12"/>
            <Grid ColumnDefinitions="*,Auto">
                <TextBox Grid.Column="0"
                         Text="{Binding SaveDirectory}"
                         PlaceholderText="Select folder to store covers and library..."
                         Margin="0,0,8,0"/>
                <Button Grid.Column="1"
                        Content="Browse..."
                        Click="Browse_Click"/>
            </Grid>
        </StackPanel>

        <!-- ======================================================== -->
        <!-- ACTION BUTTONS                                          -->
        <!-- ======================================================== -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="10"
                    Margin="0,16,0,0">

            <Button Content="Cancel"
                    Click="Cancel_Click"
                    Padding="16,6"/>

            <Button Content="Save"
                    Click="Save_Click"
                    Padding="16,6"/>
        </StackPanel>

    </StackPanel>
</Window>
