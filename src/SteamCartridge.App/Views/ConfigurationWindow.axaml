<!-- FirstLaunchSetupWindow.axaml -->
<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SteamCartridge.App.ViewModels"
    x:Class="SteamCartridge.App.Views.ConfigurationWindow"
    x:DataType="vm:ConfigurationWindowModel"
    Width="420"
    Height="450"
    CanResize="False"
    WindowStartupLocation="CenterOwner"
    Icon="/Assets/avalonia-logo.ico"
    Title="Initial Setup">

    <StackPanel Margin="20" Spacing="12">

        <TextBlock
            FontSize="22"
            FontWeight="Bold"
            Text="SteamCartridge" />

        <TextBlock
            TextWrapping="Wrap"
            Text="Please provide some configuration information before continuing." />

        <TextBlock Text="Steam Client ID" />
        <TextBox Text="{Binding SteamClientID}" />

        <TextBlock Text="Steam API Key" />
        <TextBox Text="{Binding SteamAPIKey}" />

        <TextBlock Text="Steam Grid DB API Key" />
        <TextBox Text="{Binding SteamGridDBAPIKey}" />

        <TextBlock Text="Save directory" />
        <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBox Width="300" Text="{Binding SaveDirectory}" />
            <Button Content="Browse..." Click="Browse_Click" />
        </StackPanel>

        <StackPanel
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Spacing="10">

            <Button
                Content="Cancel"
                Click="Cancel_Click" />

            <Button
                Content="Save"
                Click="Save_Click" />
        </StackPanel>
    </StackPanel>
</Window>